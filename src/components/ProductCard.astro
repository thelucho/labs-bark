---
interface Props {
	index: number;
	name: string;
	category: string;
	image: string;
	alt: string;
	note: string;
	meta: { label: string; value: string }[];
}

const { index, name, category, image, alt, note, meta } = Astro.props;
---

<article class="product" data-reveal="up">
	<a class="product__link" href="#collection">
		<div class="product__frame">
			<img src={image} alt={alt} loading="lazy" decoding="async" width="1024" height="768" />

			<span class="product__index">{String(index).padStart(2, '0')}</span>

			<div class="product__meta">
				<dl>
					{
						meta.map((item) => (
							<div>
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		<div class="product__info">
			<div>
				<h3 class="product__name">{name}</h3>
				<p class="product__category">{category}</p>
			</div>

			<span class="product__cue" aria-hidden="true">
				<svg viewBox="0 0 12 12" fill="none">
					<path
						d="M2 10 10 2M4 2h6v6"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
		</div>

		<p class="product__note">{note}</p>
	</a>
</article>

<style>
	.product__link {
		display: grid;
		gap: 1.125rem;
		text-decoration: none;
	}

	.product__frame {
		position: relative;
		aspect-ratio: 4 / 3;
		border-radius: var(--r-xl);
		overflow: hidden;
		background: var(--sand);
		transition:
			transform 0.7s var(--ease-out),
			box-shadow 0.7s var(--ease-out);
	}

	.product__link:hover .product__frame,
	.product__link:focus-visible .product__frame {
		transform: translateY(-0.375rem);
		box-shadow: 0 2.25rem 3.5rem -2rem rgb(20 17 14 / 0.45);
	}

	.product__frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1s var(--ease-out);
	}

	.product__link:hover .product__frame img {
		transform: scale(1.05);
	}

	.product__index {
		position: absolute;
		top: 1rem;
		left: 1.125rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		font-variant-numeric: tabular-nums;
		color: var(--ink-faint);
		mix-blend-mode: multiply;
	}

	/* Specification strip, held below the frame until the card is engaged. */
	.product__meta {
		position: absolute;
		inset: auto 0 0;
		padding: 2.5rem 1.125rem 1.125rem;
		background: linear-gradient(to top, rgb(16 11 6 / 0.72), rgb(16 11 6 / 0));
		opacity: 0;
		transform: translateY(35%);
		transition:
			opacity 0.5s var(--ease-out),
			transform 0.6s var(--ease-out);
	}

	.product__link:hover .product__meta,
	.product__link:focus-visible .product__meta {
		opacity: 1;
		transform: translateY(0);
	}

	.product__meta dl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		margin: 0;
	}

	.product__meta dt {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.6);
	}

	.product__meta dd {
		margin: 0.2rem 0 0;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #fff;
	}

	.product__info {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.product__name {
		font-size: var(--t-h3);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: var(--ink);
	}

	.product__category {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	.product__cue {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--ink);
		transition:
			background-color 0.4s var(--ease-soft),
			color 0.4s var(--ease-soft),
			transform 0.4s var(--ease-out);
	}

	.product__cue svg {
		width: 0.75rem;
		height: 0.75rem;
	}

	.product__link:hover .product__cue,
	.product__link:focus-visible .product__cue {
		background: var(--ink);
		color: var(--bone);
		transform: rotate(45deg);
	}

	.product__note {
		max-width: 34ch;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-soft);
		text-wrap: pretty;
	}
</style>
