---
import ProductCard from './ProductCard.astro';

const products = [
	{
		index: 1,
		name: 'BARK One',
		category: 'Smart Collar',
		image: '/images/bark-one-collar.jpg',
		alt: 'A charcoal woven smart collar with a brushed aluminium module',
		note: 'Recycled webbing, machined buckle, a battery that outlasts your good intentions.',
		meta: [
			{ label: 'Material', value: 'Recycled webbing' },
			{ label: 'Battery', value: '21 days' },
			{ label: 'Weight', value: '38 g' },
		],
	},
	{
		index: 2,
		name: 'BARK Sound',
		category: 'Pet Audio System',
		image: '/images/bark-sound-speaker.jpg',
		alt: 'A small cylindrical speaker wrapped in sand-coloured acoustic fabric',
		note: 'Tuned for canine hearing, which mostly meant removing almost everything.',
		meta: [
			{ label: 'Drivers', value: '2-way' },
			{ label: 'Range', value: '40 Hz – 45 kHz' },
			{ label: 'Presets', value: '12' },
		],
	},
	{
		index: 3,
		name: 'BARK Rest',
		category: 'Adaptive Bed',
		image: '/images/bark-rest-bed.jpg',
		alt: 'A round oatmeal boucle dog bed on a pale concrete floor',
		note: 'Temperature-adaptive foam for a species that will still choose the floor.',
		meta: [
			{ label: 'Cover', value: 'Wool bouclé' },
			{ label: 'Core', value: 'Adaptive foam' },
			{ label: 'Sizes', value: 'S – XL' },
		],
	},
	{
		index: 4,
		name: 'BARK Bowl',
		category: 'Smart Feeding System',
		image: '/images/bark-bowl.jpg',
		alt: 'A bone-white ceramic dog bowl set into a matte aluminium base',
		note: 'Portions to the gram. Negotiations with the dog sold separately.',
		meta: [
			{ label: 'Vessel', value: 'Glazed ceramic' },
			{ label: 'Accuracy', value: '± 1 g' },
			{ label: 'Capacity', value: '900 ml' },
		],
	},
];
---

<section class="products section" id="collection">
	<div class="shell">
		<header class="products__head">
			<div class="products__intro">
				<p class="eyebrow" data-reveal="up">03 — The collection</p>
				<h2 class="headline products__title" data-reveal="up">
					Four objects.<br /><span class="serif">Endlessly reviewed.</span>
				</h2>
			</div>

			<p class="products__note" data-reveal="up">
				Every piece in the collection had to survive one test: would a dog notice if it were
				better? Four of them did.
			</p>
		</header>

		<div class="products__grid">
			{products.map((product) => <ProductCard {...product} />)}
		</div>
	</div>
</section>

<style>
	.products__head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
		align-items: end;
		gap: clamp(1.5rem, 4vw, 4rem);
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	.products__intro {
		display: grid;
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}

	.products__title .serif {
		color: var(--ink-faint);
	}

	.products__note {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.products__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 4.5rem) clamp(1.5rem, 3vw, 3.5rem);
	}

	/* Staggered column keeps the pairing editorial rather than catalogue-like. */
	.products__grid > :global(*:nth-child(even)) {
		margin-top: clamp(2rem, 6vw, 6rem);
	}

	@media (max-width: 56rem) {
		.products__head {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.products__note {
			max-width: 34rem;
		}
	}

	@media (max-width: 42rem) {
		.products__grid {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}

		.products__grid > :global(*:nth-child(even)) {
			margin-top: 0;
		}
	}
</style>
