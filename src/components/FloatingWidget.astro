---
interface Props {
	/** Small caps header. Omitted on media cards, where the image does the labelling. */
	label?: string;
	/** Vertical nudge in rem, used to break the stack out of a rigid rhythm. */
	offset?: number;
	/** panel: telemetry readout · media: image-led editorial card */
	variant?: 'panel' | 'media';
	class?: string;
}

const { label, offset = 0, variant = 'panel', class: className = '' } = Astro.props;
---

<article
	class:list={['widget', 'glass', `widget--${variant}`, className]}
	style={`--offset: ${offset}rem`}
	data-reveal="up"
>
	{
		label && (
			<header class="widget__head">
				<p class="widget__label">{label}</p>
				<slot name="badge" />
			</header>
		)
	}

	<slot />
</article>

<style>
	.widget {
		--offset: 0rem;

		position: relative;
		display: grid;
		gap: 0.875rem;
		/* Margin rather than transform, so hover and reveal tweens stay uncontested. */
		margin-top: var(--offset);
		border-radius: var(--r-lg);
		pointer-events: auto;
		transition:
			transform 0.6s var(--ease-out),
			box-shadow 0.6s var(--ease-out);
	}

	.widget--panel {
		padding: 1.125rem 1.25rem 1.25rem;
	}

	/* Uniform padding so the card surface reads as a mount around the image. */
	.widget--media {
		gap: 0.75rem;
		padding: 0.625rem;
	}

	.widget:hover {
		transform: translateY(-0.375rem);
		box-shadow: 0 2rem 3.5rem -1.5rem rgb(60 30 0 / 0.45);
	}

	.widget__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.widget__label {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		line-height: 1;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
</style>
