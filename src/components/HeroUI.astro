---
import FloatingWidget from './FloatingWidget.astro';

const cycle = ['Walk', 'Rest', 'Play', 'Repeat'];
---

<div class="heroUi">
	<div class="heroUi__lead">
		<p class="heroUi__eyebrow" data-reveal="up">The modern pet standard</p>

		<h1 class="heroUi__title" data-reveal="up">
			Thoughtfully designed for <span class="serif">modern pets.</span>
		</h1>

		<p class="heroUi__copy" data-reveal="up">
			Because being a good dog is already a full-time job.
		</p>

		<div class="heroUi__actions" data-reveal="up">
			<a class="btn" href="#collection" data-magnetic="0.22">
				Explore BARK™
				<svg class="btn__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path
						d="M2 10 10 2M4 2h6v6"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>

			<a class="heroUi__link" href="#about">The philosophy</a>
		</div>
	</div>

	<div class="heroUi__widgets">
		<FloatingWidget label="Currently listening">
			<span slot="badge" class="eq" aria-hidden="true">
				<i></i><i></i><i></i><i></i>
			</span>

			<p class="heroUi__track">lo-fi / rainy afternoon</p>

			<p class="heroUi__stat">
				<span class="dot"></span>
				98% tail wag probability
			</p>
		</FloatingWidget>

		<FloatingWidget variant="media" offset={1.5}>
			<figure class="story">
				<div class="story__frame">
					<div class="story__media">
						<img
							src="/images/bento-rest.jpg"
							alt="A beagle asleep in a cream bouclé bed"
							width="1024"
							height="768"
							decoding="async"
						/>
					</div>

					<button class="story__save" type="button" aria-pressed="false" data-hero-save>
						<span class="story__saveLabel">Save this story</span>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M12 20.4s-7-4.3-7-9.1a3.9 3.9 0 0 1 7-2.4 3.9 3.9 0 0 1 7 2.4c0 4.8-7 9.1-7 9.1Z"
								stroke-linejoin="round"></path>
						</svg>
					</button>
				</div>

				<figcaption class="story__body">
					<p class="story__title">Pet health</p>
					<p class="story__meta">Journal / 6 min read</p>
				</figcaption>
			</figure>
		</FloatingWidget>
	</div>

	<div class="heroUi__status">
		<div class="heroUi__system glass">
			<span>BARK™ System</span>
			<span class="heroUi__systemSep" aria-hidden="true"></span>
			<span class="heroUi__systemCopy">Designed for modern pets</span>
			<span class="heroUi__systemState"><span class="dot"></span>Online</span>
		</div>

		<ol class="heroUi__cycle">
			{
				cycle.map((step, index) => (
					<li>
						<span class="heroUi__cycleNum">{String(index + 1).padStart(2, '0')}</span>
						{step}
					</li>
				))
			}
		</ol>
	</div>
</div>

<script>
	const save = document.querySelector<HTMLButtonElement>('[data-hero-save]');

	save?.addEventListener('click', () => {
		const saved = save.getAttribute('aria-pressed') === 'true';
		save.setAttribute('aria-pressed', String(!saved));
	});
</script>

<style>
	.heroUi {
		/* Ink softened against the amber plate; still clears 4.5:1 for body copy. */
		--hero-ink: rgb(20 17 14 / 0.82);

		position: absolute;
		inset: var(--nav-height) 0 var(--inset);
		display: grid;
		grid-template-columns: minmax(0, 28rem) minmax(3rem, 1fr) minmax(0, 16.5rem);
		grid-template-rows: 1fr auto;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2.5rem);
		padding: clamp(1.25rem, 2.5vw, 2.5rem) clamp(1.75rem, 4vw, 4rem) clamp(1.25rem, 2vw, 1.75rem);
		pointer-events: none;
	}

	/* ---- Left: the statement ---- */

	.heroUi__lead {
		display: grid;
		justify-items: start;
		gap: 1.25rem;
		max-width: 28rem;
	}

	.heroUi__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		line-height: 1;
		text-transform: uppercase;
		color: var(--hero-ink);
	}

	.heroUi__eyebrow::before {
		content: '';
		width: 1.75rem;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	.heroUi__title {
		font-size: clamp(2.25rem, 1rem + 3.1vw, 3.75rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.045em;
		color: var(--ink);
		/* Whisper-thin chromatic fringe; reads as print misregistration, not neon. */
		text-shadow:
			0.014em 0 rgb(255 60 0 / 0.16),
			-0.014em 0 rgb(0 120 255 / 0.14);
	}

	/* Kept whole so the serif phrase always reads as one editorial line. */
	.heroUi__title .serif {
		font-size: 1.06em;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	.heroUi__copy {
		max-width: 26ch;
		font-size: clamp(0.9375rem, 0.85rem + 0.25vw, 1.0625rem);
		line-height: 1.5;
		color: var(--hero-ink);
		text-wrap: pretty;
	}

	.heroUi__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-top: 0.25rem;
		pointer-events: auto;
	}

	.heroUi__link {
		position: relative;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--hero-ink);
		text-decoration: none;
	}

	.heroUi__link::after {
		content: '';
		position: absolute;
		inset: auto 0 -0.3rem 0;
		height: 1px;
		background: currentColor;
		transform-origin: right center;
		transition: transform 0.45s var(--ease-out);
	}

	.heroUi__link:hover::after {
		transform-origin: left center;
		transform: scaleX(0.35);
	}

	/* ---- Right: product telemetry ---- */

	.heroUi__widgets {
		display: grid;
		gap: 0.875rem;
		grid-column: 3;
		justify-self: end;
		width: 100%;
		max-width: 16.5rem;
	}

	.heroUi__track {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.heroUi__stat {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	.eq {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.875rem;
	}

	.eq i {
		width: 2px;
		border-radius: 1px;
		background: var(--brand-deep);
		transform-origin: bottom center;
		animation: eq 1.1s var(--ease-soft) infinite alternate;
	}

	.eq i:nth-child(1) {
		height: 40%;
		animation-delay: -0.4s;
	}
	.eq i:nth-child(2) {
		height: 100%;
		animation-delay: -0.9s;
	}
	.eq i:nth-child(3) {
		height: 65%;
		animation-delay: -0.15s;
	}
	.eq i:nth-child(4) {
		height: 85%;
		animation-delay: -0.65s;
	}

	@keyframes eq {
		from {
			transform: scaleY(0.35);
		}
		to {
			transform: scaleY(1);
		}
	}

	/* ---- Editorial card ---- */

	.story {
		display: grid;
		gap: 0.75rem;
		margin: 0;
	}

	/* Holds the badge outside the image so it is not clipped by the rounded mask. */
	.story__frame {
		position: relative;
	}

	.story__media {
		aspect-ratio: 3 / 2;
		/* Inner radius tracks the outer one minus the card padding. */
		border-radius: calc(var(--r-lg) - 0.625rem);
		overflow: hidden;
		background: var(--sand);
	}

	.story__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1s var(--ease-out);
	}

	.widget:hover .story__media img {
		transform: scale(1.05);
	}

	.story__save {
		position: absolute;
		right: -0.5rem;
		bottom: -1.25rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--ink);
		color: var(--bone);
		cursor: pointer;
		box-shadow: 0 0.5rem 1.25rem -0.5rem rgb(20 17 14 / 0.65);
		transition:
			transform 0.4s var(--ease-out),
			background-color 0.35s var(--ease-soft);
	}

	.story__save:hover {
		transform: scale(1.08);
	}

	.story__save[aria-pressed='true'] {
		background: var(--brand-deep);
	}

	.story__saveLabel {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.story__save svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		transition: fill 0.35s var(--ease-soft);
	}

	.story__save[aria-pressed='true'] svg {
		fill: currentColor;
	}

	.story__body {
		/* Keeps the copy clear of the badge. */
		padding: 0 1.75rem 0.375rem 0.375rem;
	}

	.story__title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.story__meta {
		margin-top: 0.15rem;
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	/* ---- Bottom: status strip ---- */

	.heroUi__status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		grid-column: 1 / -1;
		grid-row: 2;
	}

	.heroUi__system {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem;
		border-radius: var(--r-pill);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.heroUi__systemSep {
		width: 1px;
		height: 0.75rem;
		background: var(--line-strong);
	}

	.heroUi__systemCopy {
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: none;
		color: var(--ink-soft);
	}

	.heroUi__systemState {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.heroUi__cycle {
		display: flex;
		gap: clamp(0.75rem, 1.6vw, 1.75rem);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		line-height: 1;
		text-transform: uppercase;
		color: #fff;
		text-shadow: 0 1px 3px rgb(40 18 0 / 0.45);
	}

	.heroUi__cycle li {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.heroUi__cycleNum {
		font-variant-numeric: tabular-nums;
		color: rgb(255 255 255 / 0.75);
	}

	/* ---- Responsive art direction ---- */

	@media (max-width: 68rem) {
		.heroUi {
			grid-template-columns: minmax(0, 21rem) minmax(2rem, 1fr) minmax(0, 14.5rem);
		}

		.heroUi__widgets {
			max-width: 14.5rem;
		}
	}

	/*
	 * Under ~54rem the frame sequence crops to a near-square and the dog fills the
	 * plate edge to edge. Rather than shrinking the desktop overlay, the statement
	 * drops out of the image and becomes an editorial block underneath it; only the
	 * status pill stays, straddling the bottom edge of the hero.
	 */
	@media (max-width: 54rem) {
		.heroUi {
			position: static;
			display: grid;
			grid-template-columns: 1fr;
			gap: 2.25rem;
			padding: 0 var(--gutter) 0;
			pointer-events: auto;
		}

		.heroUi__status {
			order: -1;
			grid-column: auto;
			grid-row: auto;
			justify-content: center;
			margin-top: -1.5rem;
		}

		.heroUi__cycle {
			display: none;
		}

		.heroUi__lead {
			gap: 1.5rem;
			max-width: 30rem;
		}

		.heroUi__title {
			font-size: clamp(2.5rem, 1.5rem + 5vw, 3.5rem);
			text-shadow: none;
		}

		.heroUi__eyebrow,
		.heroUi__copy,
		.heroUi__link {
			color: var(--ink-soft);
		}

		.heroUi__widgets {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-column: auto;
			justify-self: stretch;
			max-width: none;
		}

		.heroUi__widgets :global(.widget) {
			margin-top: 0;
			background: var(--paper);
			border-color: var(--line);
			box-shadow: none;
			backdrop-filter: none;
		}
	}

	@media (max-width: 30rem) {
		.heroUi__systemCopy,
		.heroUi__systemSep {
			display: none;
		}

		.heroUi__widgets {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.eq i {
			animation: none;
			transform: scaleY(0.7);
		}
	}
</style>
