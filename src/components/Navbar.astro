---
const links = [
	{ label: 'Collection', href: '#collection' },
	{ label: 'Wellness', href: '#wellness' },
	{ label: 'Lifestyle', href: '#lifestyle' },
	{ label: 'About', href: '#about' },
];
---

<header class="nav" data-nav>
	<div class="nav__bar">
		<a class="nav__brand" href="#top">
			BARK<span class="nav__tm">™</span>
		</a>

		<nav class="nav__links" aria-label="Primary">
			{
				links.map((link) => (
					<a class="nav__link" href={link.href}>
						<span class="nav__linkMask">
							<span class="nav__linkText" data-label={link.label}>
								{link.label}
							</span>
						</span>
					</a>
				))
			}
		</nav>

		<div class="nav__actions">
			<button class="nav__icon" type="button" aria-label="Search">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.6"></circle>
					<path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</button>

			<button class="nav__icon" type="button" aria-label="Bag, 2 items">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M5 8h14l-1 11.5a1.4 1.4 0 0 1-1.4 1.2H7.4A1.4 1.4 0 0 1 6 19.5L5 8Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linejoin="round"></path>
					<path
						d="M9 10V7.5a3 3 0 0 1 6 0V10"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"></path>
				</svg>
				<span class="nav__badge" aria-hidden="true">2</span>
			</button>

			<a class="nav__cta" href="#collection" data-magnetic="0.2">
				Explore
				<svg class="btn__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path
						d="M2 10 10 2M4 2h6v6"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>
	</div>
</header>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		padding: var(--inset) var(--inset) 0;
		pointer-events: none;
	}

	.nav__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(1rem, 3vw, 3rem);
		height: calc(var(--nav-height) - var(--inset));
		padding-inline: clamp(1rem, 2.2vw, 1.75rem);
		border: 1px solid transparent;
		border-radius: var(--r-pill);
		pointer-events: auto;
		transition:
			background-color 0.5s var(--ease-soft),
			border-color 0.5s var(--ease-soft),
			box-shadow 0.5s var(--ease-soft),
			backdrop-filter 0.5s var(--ease-soft);
	}

	.nav.is-floating .nav__bar {
		background: rgb(255 255 255 / 0.72);
		border-color: rgb(255 255 255 / 0.7);
		box-shadow: 0 1rem 2.5rem -1.25rem rgb(20 17 14 / 0.3);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
	}

	.nav__brand {
		font-size: 1.375rem;
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.nav__tm {
		font-size: 0.5em;
		font-weight: 600;
		vertical-align: super;
		letter-spacing: 0;
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2vw, 2rem);
	}

	.nav__link {
		display: flex;
		align-items: center;
		height: 2.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-decoration: none;
		color: var(--ink-soft);
		transition: color 0.3s var(--ease-soft);
	}

	.nav__link:hover {
		color: var(--ink);
	}

	/* Keeps the duplicated label hidden until the roll pulls it into view. */
	.nav__linkMask {
		display: block;
		overflow: hidden;
		line-height: 1.35;
	}

	.nav__linkText {
		position: relative;
		display: block;
		transition: transform 0.45s var(--ease-out);
	}

	.nav__linkText::after {
		content: attr(data-label);
		position: absolute;
		top: 100%;
		left: 0;
	}

	.nav__link:hover .nav__linkText,
	.nav__link:focus-visible .nav__linkText {
		transform: translateY(-100%);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	.nav__icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--ink-soft);
		cursor: pointer;
		transition:
			background-color 0.3s var(--ease-soft),
			color 0.3s var(--ease-soft);
	}

	.nav__icon:hover {
		background: rgb(20 17 14 / 0.06);
		color: var(--ink);
	}

	.nav__icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.nav__badge {
		position: absolute;
		top: 0.45rem;
		right: 0.5rem;
		display: grid;
		place-items: center;
		min-width: 1rem;
		height: 1rem;
		padding-inline: 0.2rem;
		border-radius: var(--r-pill);
		background: var(--ink);
		color: var(--bone);
		font-size: 0.5625rem;
		font-weight: 700;
		line-height: 1;
	}

	.nav__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		margin-left: 0.5rem;
		padding: 0.5rem 1.125rem;
		border-radius: var(--r-pill);
		background: var(--ink);
		color: var(--bone);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
		transition: box-shadow 0.3s var(--ease-soft);
	}

	.nav__cta:hover {
		box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(20 17 14 / 0.65);
	}

	.nav__cta .btn__arrow {
		width: 0.6875rem;
		height: 0.6875rem;
		transition: transform 0.35s var(--ease-out);
	}

	.nav__cta:hover .btn__arrow {
		transform: translate(0.15rem, -0.15rem);
	}

	@media (max-width: 60rem) {
		.nav__links {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		.nav__cta {
			display: none;
		}
	}
</style>
