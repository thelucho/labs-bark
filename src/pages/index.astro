---
import DogDashboard from '../components/DogDashboard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Navbar from '../components/Navbar.astro';
import PersonalitySelector from '../components/PersonalitySelector.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
